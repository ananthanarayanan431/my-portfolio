---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  name: string;
  nav: readonly NavItem[];
}

const { name, nav } = Astro.props;
---

<header>
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-6">
    <a href="/" class="font-medium lowercase text-[var(--text)]">{name}</a>
    <div class="flex items-center gap-5">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm lowercase text-[var(--text-muted)] hover:text-[var(--text)]"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
