---
import { SITE } from '../config/site';

const ICONS = {
  github:
    'M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.7.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.71h.05c.53-.95 1.83-1.96 3.76-1.96 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.19 1.45-2.19 2.96V21H9z',
  email:
    'M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5zm2.3-.5 7.7 6.1L19.7 5z',
};

const profiles = [
  {
    label: 'GitHub',
    icon: ICONS.github,
    href: `https://github.com/${SITE.githubUser}`,
    detail: '114 followers · 94 repos',
  },
  {
    label: 'LinkedIn',
    icon: ICONS.linkedin,
    href: 'https://www.linkedin.com/in/rananthanarayananofficial/',
    detail: '3,150 followers',
  },
  { label: 'Email', icon: ICONS.email, href: `mailto:${SITE.email}`, detail: SITE.email },
];
---

<section class="pt-10 pb-12">
  <img
    src={SITE.photo}
    alt={`Photo of ${SITE.name}`}
    width="96"
    height="96"
    class="h-24 w-24 rounded-full border border-[var(--border)] object-cover"
  />

  <h1 class="mt-5 text-2xl font-bold tracking-tight">{SITE.name}</h1>
  <p class="mt-1 text-[var(--text-muted)]">{SITE.title}</p>

  <p class="mt-6 max-w-xl text-lg font-medium leading-snug">
    I build AI agents that ship to production and keep working when real users show up.
  </p>
  <p class="mt-3 max-w-xl leading-relaxed text-[var(--text-muted)]">
    Product Engineer at Oraczen with 2+ years in AI. I design multi-agent systems, RAG pipelines,
    LLM-as-a-Judge evaluations, and real-time voice agents over WebRTC. I also write about what I
    build, so other engineers can ship production AI instead of just following tutorials.
  </p>

  <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--text-muted)]">
    {
      profiles.map((profile) => (
        <li>
          <a
            href={profile.href}
            aria-label={`${profile.label}: ${profile.detail}`}
            target="_blank"
            rel="me noopener noreferrer"
            class="flex items-center gap-2 transition-colors hover:text-[var(--text)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={profile.icon} />
            </svg>
            <span>{profile.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-7 flex flex-wrap items-center gap-3">
    <a
      href={SITE.resumePath}
      class="rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-[var(--bg)] hover:opacity-90"
    >
      Download resume
    </a>
    <a
      href={`mailto:${SITE.email}`}
      class="rounded-md border border-[var(--border)] px-4 py-2 text-sm font-medium hover:border-[var(--text-muted)]"
    >
      Get in touch
    </a>
  </div>
</section>
