---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
}

const { title, subtitle, href } = Astro.props;
---

<section class="py-10">
  <div class="mb-6 flex items-baseline justify-between gap-4">
    <div>
      <h2 class="text-xl font-semibold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-1 text-sm text-[var(--text-muted)]">{subtitle}</p>}
    </div>
    {
      href && (
        <a href={href} class="shrink-0 text-sm text-[var(--text-muted)] hover:text-[var(--text)]">
          all &rarr;
        </a>
      )
    }
  </div>
  <slot />
</section>
