---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE } from '../config/site';

interface Props {
  name: string;
  description: string;
  tech?: string[];
  liveUrl?: string;
  repoUrl?: string;
  headings?: MarkdownHeading[];
}

const { name, description, tech = [], liveUrl, repoUrl, headings = [] } = Astro.props;
---

<BaseLayout title={`${name} | ${SITE.name}`} description={description}>
  <article class="relative py-12">
    <aside class="absolute top-0 left-full ml-10 hidden h-full w-56 xl:block">
      <div class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto py-12">
        <TableOfContents headings={headings} />
      </div>
    </aside>
    <a href="/projects" class="text-sm text-[var(--text-muted)] hover:text-[var(--text)]">
      &larr; All projects
    </a>
    <header class="mt-6 border-b border-[var(--border)] pb-6">
      <h1 class="text-3xl font-bold tracking-tight">{name}</h1>
      <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{description}</p>
      {
        tech.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {tech.map((item) => (
              <li class="rounded bg-[var(--bg-subtle)] px-2 py-0.5 text-xs text-[var(--text-muted)]">
                {item}
              </li>
            ))}
          </ul>
        )
      }
      {
        (repoUrl || liveUrl) && (
          <div class="mt-5 flex flex-wrap gap-3 text-sm">
            {repoUrl && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md bg-[var(--text)] px-3 py-1.5 font-medium text-[var(--bg)] hover:opacity-90"
              >
                Source code on GitHub &#8599;
              </a>
            )}
            {liveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md border border-[var(--border)] px-3 py-1.5 font-medium hover:border-[var(--text-muted)]"
              >
                Live demo &#8599;
              </a>
            )}
          </div>
        )
      }
    </header>
    {
      headings.length > 0 && (
        <details class="mt-6 rounded-lg border border-[var(--border)] px-4 py-3 xl:hidden">
          <summary class="cursor-pointer text-sm font-medium">On this page</summary>
          <div class="mt-3">
            <TableOfContents headings={headings} />
          </div>
        </details>
      )
    }
    <div class="prose-custom mt-8 space-y-4 leading-relaxed">
      <slot />
    </div>
    {
      repoUrl && (
        <footer class="mt-12 rounded-lg border border-[var(--border)] p-5">
          <p class="font-medium">Explore the complete source code</p>
          <p class="mt-1 text-sm text-[var(--text-muted)]">
            The full implementation, documentation and setup instructions live on GitHub.
          </p>
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block text-sm font-medium underline"
          >
            {repoUrl.replace(/^https?:\/\/(www\.)?/, '')} &#8599;
          </a>
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .prose-custom :global(h2),
  .prose-custom :global(h3) {
    scroll-margin-top: 1.5rem;
  }
  .prose-custom :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .prose-custom :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .prose-custom :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .prose-custom :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-custom :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .prose-custom :global(li + li) {
    margin-top: 0.35rem;
  }
  .prose-custom :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .prose-custom :global(code) {
    background: var(--bg-subtle);
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    font-size: 0.9em;
  }
  .prose-custom :global(pre) {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .prose-custom :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-custom :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .prose-custom :global(th),
  .prose-custom :global(td) {
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
    vertical-align: top;
  }
  .prose-custom :global(th) {
    font-weight: 600;
  }
</style>
