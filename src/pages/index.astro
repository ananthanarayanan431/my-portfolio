---
import { getCollection } from 'astro:content';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Activity from '../components/Activity.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../lib/projects';

const featured = featuredProjects(await getCollection('projects'), 4);
---

<BaseLayout title={`${SITE.name} | ${SITE.title}`} description={SITE.description}>
  <Hero />
  <Section title="Activity" subtitle="GitHub contributions over the last year.">
    <Activity />
  </Section>
  <Section title="Projects" subtitle="Some of the things I've been building." href="/projects">
    {
      featured.length === 0 ? (
        <p class="text-[var(--text-muted)]">No projects yet.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {featured.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </Section>
  <Section title="Experience" subtitle="Where I've worked.">
    <Experience />
  </Section>
  <Section title="Skills" subtitle="Tools and technologies I use.">
    <Skills />
  </Section>
  <Section
    title="Contact"
    subtitle="Building something with AI agents? I'm open to roles, collaborations, and consulting."
  >
    <a
      href={`mailto:${SITE.email}`}
      class="text-lg font-medium underline decoration-[var(--border)] underline-offset-4 hover:decoration-[var(--text)]"
    >
      {SITE.email}
    </a>
    <p class="mt-4 text-sm text-[var(--text-muted)]">
      You can also reach me on{' '}
      {
        SITE.socials
          .filter((social) => social.icon !== 'email')
          .map((social, i, list) => (
            <>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text)] underline decoration-[var(--border)] underline-offset-4 hover:decoration-[var(--text)]"
              >
                {social.label}
              </a>
              {i < list.length - 1 ? ' or ' : '.'}
            </>
          ))
      }
    </p>
  </Section>
</BaseLayout>
